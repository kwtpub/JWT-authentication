NODE_ENV=development
PORT=3001
DB_URL=mongodb://127.0.0.1:27017/jwt_authentication
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3001

# Generate each value independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Use a local SMTP catcher during development; email links are never logged.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=auth@example.test
